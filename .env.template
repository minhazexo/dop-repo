# Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ====================
# Frontend Environment
# ====================

# API Base URL for production
REACT_APP_API_URL=https://your-backend-url.onrender.com/api

# Site URL
REACT_APP_SITE_URL=https://your-site.netlify.app

# Google Analytics (optional)
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry DSN for error tracking (optional)
REACT_APP_SENTRY_DSN=https://xxxxxxxxxxxxx.ingest.sentry.io/xxxxxxx

# ====================
# Backend Environment (for Server/.env)
# ====================

# Database Configuration
DB_HOST=your-database-host
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Server Configuration
PORT=5010
NODE_ENV=production

# CORS Origins (comma separated)
CORS_ORIGINS=https://your-site.netlify.app,http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880 # 5MB

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ====================
# Netlify Environment Variables
# ====================
# Set these in Netlify Dashboard → Site settings → Environment variables
#
# Required:
# - REACT_APP_API_URL
#
# Optional:
# - NODE_VERSION (default: 18)
# - NPM_FLAGS (default: --legacy-peer-deps)

# ====================
# GitHub Secrets (for GitHub Actions)
# ====================
# Set these in GitHub → Settings → Secrets and variables → Actions
#
# Required:
# - NETLIFY_AUTH_TOKEN
# - NETLIFY_SITE_ID
# - REACT_APP_API_URL
#
# Optional:
# - SENTRY_AUTH_TOKEN
# - GA_TRACKING_ID